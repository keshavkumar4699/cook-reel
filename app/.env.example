# Where the CookReel API runs. Android emulators reach your computer at 10.0.2.2;
# on a physical phone use your computer's LAN IP (e.g. http://192.168.1.20:8787).
EXPO_PUBLIC_API_URL=http://localhost:8787

# Google Sign-In (Google Cloud console → Credentials). The web client ID is the audience of the
# ID token the app sends to the server; the iOS client ID's reversed form is the URL scheme.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# RevenueCat public SDK keys (Project settings → API keys).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Native identifiers.
APP_BUNDLE_ID=com.cookreel.app
