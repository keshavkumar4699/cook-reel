# ── Server ────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
# Long random string (openssl rand -hex 32). Required in production.
JWT_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────────────
# Postgres 15+ with the pgvector extension (Neon, Supabase, RDS, Railway…). Required in production.
# Leave empty in development to use the embedded Postgres (PGlite) stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# ── AI ────────────────────────────────────────────────────────────────────────────────
# Claude writes recipes, runs the chat and turns video breakdowns into step-by-step recipes.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallbacks (Claude API). Set false when routing through Bedrock/Vertex/a proxy.
CLAUDE_FALLBACKS=true

# Gemini watches YouTube videos and powers the recipe-memory embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Sign-in ───────────────────────────────────────────────────────────────────────────
# Comma-separated OAuth client IDs whose Google ID tokens are accepted (web client ID is the one
# @react-native-google-signin returns tokens for; add iOS/Android IDs too if you use them).
GOOGLE_CLIENT_IDS=
# Comma-separated iOS bundle IDs (and Services IDs) for Sign in with Apple.
APPLE_BUNDLE_IDS=com.cookreel.app
# Optional, but required for App Store approval: revoke Apple tokens when an account is deleted.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key; newlines may be written as \n
APPLE_PRIVATE_KEY=

# Development-only passwordless sign-in (never enable in production).
ALLOW_DEV_LOGIN=true

# ── Billing (RevenueCat) ──────────────────────────────────────────────────────────────
# Value of the Authorization header configured on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat secret API key (v1) used to read a customer's purchases.
REVENUECAT_SECRET_KEY=
# Optional JSON file overriding plans, credit costs and top-ups (see src/domain/pricing.ts).
PRICING_CONFIG_PATH=

# Optional comma-separated list of allowed browser origins.
CORS_ORIGINS=
